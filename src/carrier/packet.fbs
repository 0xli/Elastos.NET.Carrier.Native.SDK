namespace carrier;

table userinfo {
    avatar : bool = false;
    name   : string;
    descr  : string;
    phone  : string;
    gender : string;
    email  : string;
    region : string;
    // AgentNet client metadata (APPENDED - FlatBuffers is forward/backward
    // compatible, so a peer that predates a field just reads its default). Lets
    // peers negotiate capabilities (e.g. proto_version>=1 => supports the
    // toxcore file-transfer channel for large files, vs. inline bulkmsg) and
    // show the friend's platform/build. proto_version 0 = a legacy peer.
    // NOTE: keep this file pure ASCII - the bundled FlatCC parser rejects
    // non-ASCII bytes (e.g. an em dash), breaking the legacy CMake build.
    proto_version : uint = 0;
    platform      : string;   // "ios" | "android" | "js" | "darwin" | "linux" | "win32"
    os_version    : string;   // e.g. "17.5", "14", "node-24.2.0"
    app_version   : string;   // e.g. "beagle-2.3.1", "lan-0.1.167"
}

table friendreq {
    name   : string;
    descr  : string;
    hello  : string;
}

table friendmsg {
    ext    : string;
    msg    : [ubyte];
}

table bulkmsg {
    ext    : string;
    totalsz: uint;
    tid    : long;
    data   : [ubyte];
}

table invitereq {
    ext    : string;
    tid    : long;
    bundle : string;
    totalsz: uint;
    data   : [uint8];
}

table invitersp {
    ext    : string;
    tid    : long;
    bundle : string;
    totalsz: uint;
    status : int;
    reason : string;
    data   : [uint8];
}

union anybody {
    userinfo,
    friendreq,
    friendmsg,
    invitereq,
    invitersp,
    bulkmsg
}

table packet
{
    type   : uint8;
    body   : anybody;
}

root_type packet;

table pullmsg {
    id        : ulong;
    from      : string;
    type      : ubyte;
    timestamp : ulong;
    address   : string;
    payload   :[ubyte];
}