+bool tox_carrier_udp_defunct(Tox *tox)
+{
+    assert(tox != nullptr);
+    lock(tox);
+    const bool defunct = networking_is_defunct(tox->m->net);
+    unlock(tox);
+    return defunct;
+}
+
+bool tox_carrier_udp_rebind(Tox *tox)
+{
+    assert(tox != nullptr);
+    lock(tox);
+    const bool done = networking_rebind(tox->m->net) == 0;
+    unlock(tox);
+    return done;
+}
